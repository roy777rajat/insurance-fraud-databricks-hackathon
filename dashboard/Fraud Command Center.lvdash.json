{
  "datasets": [
    {
      "name": "f9f7fb50",
      "displayName": "gold_scored_claims_full_table",
      "queryLines": [
        "SELECT * \r\n",
        "FROM workspace.insurance_fraud.vw_claims_enriched_scored p;"
      ]
    },
    {
      "name": "58a59279",
      "displayName": "High_Risk_Claim_Table",
      "queryLines": [
        "SELECT\r\n",
        "  claim_id, report_dt, state, total_claim_amount, repair_estimate,\r\n",
        "  policy_annual_mileage, pin_valid, fraud_score, decision_flag, explanation\r\n",
        "FROM workspace.insurance_fraud.vw_claims_enriched_scored\r\n",
        "WHERE fraud_score >= 0.90 OR decision_flag <> 'PASS' \r\n",
        "ORDER BY fraud_score DESC, report_dt DESC\r\n"
      ]
    },
    {
      "name": "feb76338",
      "displayName": "Flagged rate by day",
      "queryLines": [
        "SELECT T.* from \r\n",
        "(\r\n",
        "  SELECT\r\n",
        "    DATE(report_dt) AS dt,\r\n",
        "    ROUND(100.0 * SUM(CASE WHEN decision_flag <> 'PASS' THEN 1 ELSE 0 END) / NULLIF(COUNT(*),0), 2) AS flagged_rate_pct\r\n",
        "  FROM workspace.insurance_fraud.vw_claims_enriched_scored\r\n",
        "  GROUP BY DATE(report_dt)\r\n",
        "  ORDER BY dt\r\n",
        ")T\r\n",
        "WHERE\r\n",
        "  1=1\r\n",
        "AND T.flagged_rate_pct >0\r\n",
        "order by T.flagged_rate_pct desc\r\n"
      ]
    },
    {
      "name": "74ad85c3",
      "displayName": "Top States by flagged rate",
      "queryLines": [
        "SELECT\r\n",
        "  state,\r\n",
        "  SUM(CASE WHEN decision_flag <> 'PASS' THEN 1 ELSE 0 END) AS flagged_claims,\r\n",
        "  COUNT(*) AS total_claims,\r\n",
        "  ROUND(100.0 * SUM(CASE WHEN decision_flag <> 'PASS' THEN 1 ELSE 0 END) / NULLIF(COUNT(*),0), 2) AS flagged_rate_pct\r\n",
        "FROM workspace.insurance_fraud.vw_claims_enriched_scored\r\n",
        "GROUP BY state\r\n",
        "HAVING total_claims >= 10\r\n",
        "ORDER BY flagged_rate_pct DESC\r\n",
        "LIMIT 5\r\n"
      ]
    },
    {
      "name": "c9ab23cc",
      "displayName": "Core KPI",
      "queryLines": [
        "SELECT\r\n",
        "  COUNT(*)                                                   AS total_claims,\r\n",
        "  SUM(CASE WHEN decision_flag <> 'PASS' THEN 1 ELSE 0 END)  AS flagged_claims,\r\n",
        "  ROUND(100.0 * SUM(CASE WHEN decision_flag <> 'PASS' THEN 1 ELSE 0 END) / NULLIF(COUNT(*),0), 2) AS flagged_rate_pct,\r\n",
        "  ROUND(AVG(fraud_score), 4)                                 AS avg_fraud_score,\r\n",
        "  report_dt, state, decision_flag\r\n",
        "FROM workspace.insurance_fraud.vw_claims_enriched_scored\r\n",
        "GROUP BY report_dt, state, decision_flag\r\n"
      ]
    },
    {
      "name": "2136d5d7",
      "displayName": "Explanation wise",
      "queryLines": [
        "SELECT p.explanation, p.decision_flag , count(*)\r\n",
        "FROM workspace.insurance_fraud.vw_claims_enriched_scored p\r\n",
        "WHERE p.explanation IS NOT NULL AND p.explanation != ''\r\n",
        "and p.decision_flag != 'PASS'\r\n",
        "group by p.explanation, p.decision_flag\r\n",
        "order by 3 desc"
      ]
    }
  ],
